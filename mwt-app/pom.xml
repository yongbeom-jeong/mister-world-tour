<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.misterworldtour</groupId>
        <artifactId>mwt-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>mwt-app</artifactId>
    <description>실행 모듈: 패키지 모듈 7개를 묶어 실행 jar(mwt.jar)를 만든다. 데모 데이터(demo)와 설정 파일, 전체 테스트</description>

    <dependencies>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-members</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-sms</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-travel</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-souvenir</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-speech</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-dataaccess</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.misterworldtour</groupId>
            <artifactId>mwt-ui</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <build>
        <finalName>mwt</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 저장소 루트에서 실행: .env, data/(H2), media/(업로드 사진)를 루트 기준으로 찾는다 -->
                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
