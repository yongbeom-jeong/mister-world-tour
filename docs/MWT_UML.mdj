													},
													"guard": "Configuration validation passed"
												}
											]
										},
										{
											"_type": "UMLCombinedFragment",
											"_id": "MWT_UC7_39375dadf1e84d7ab3105aea7a05ee71",
											"_parent": {
												"$ref": "MWT_UC7_92eb614f7e754e918c3826c45f458752"
											},
											"interactionOperator": "opt",
											"documentation": "Failure skips default generation, updating and successful commit. The existing work signals refusal, the transaction aborts and the common response carries correction information; exception arrows are abstracted into the footer.",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_eea3976282414ca880092c9841d41811",
													"_parent": {
														"$ref": "MWT_UC7_39375dadf1e84d7ab3105aea7a05ee71"
													},
													"guard": "Product validation passed"
												}
											]
										},
										{
											"_type": "UMLCombinedFragment",
											"_id": "MWT_UC7_79c4133db51c44d0813dd89a6a062ce7",
											"_parent": {
												"$ref": "MWT_UC7_92eb614f7e754e918c3826c45f458752"
											},
											"interactionOperator": "alt",
											"documentation": "Existing applications explicitly reject both operations. The false path proceeds to validation/updating or confirmed deletion. hasApplications is the existing Boolean return, not a new field.",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_36a1f6df2e7e4dcfb3546f50317ebb88",
													"_parent": {
														"$ref": "MWT_UC7_79c4133db51c44d0813dd89a6a062ce7"
													},
													"guard": "hasApplications = true"
												},
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_7043f50545f948ae88bbcce553b9f1f5",
													"_parent": {
														"$ref": "MWT_UC7_79c4133db51c44d0813dd89a6a062ce7"
													},
													"guard": "hasApplications = false"
												}
											]
										},
										{
											"_type": "UMLCombinedFragment",
											"_id": "MWT_UC7_39e7585e8eac4a44946aa20052747d03",
											"_parent": {
												"$ref": "MWT_UC7_92eb614f7e754e918c3826c45f458752"
											},
											"interactionOperator": "alt",
											"documentation": "Existing applications explicitly reject both operations. The false path proceeds to validation/updating or confirmed deletion. hasApplications is the existing Boolean return, not a new field.",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_6ac8df126cbd4f15b19524070886fb4f",
													"_parent": {
														"$ref": "MWT_UC7_39e7585e8eac4a44946aa20052747d03"
													},
													"guard": "hasApplications = true"
												},
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_047d791da83c498685d031911fe3277d",
													"_parent": {
														"$ref": "MWT_UC7_39e7585e8eac4a44946aa20052747d03"
													},
													"guard": "hasApplications = false"
												}
											]
										},
										{
											"_type": "UMLCombinedFragment",
											"_id": "MWT_UC7_105169ab585a4d118853ca2a6f5b65b8",
											"_parent": {
												"$ref": "MWT_UC7_92eb614f7e754e918c3826c45f458752"
											},
											"interactionOperator": "alt",
											"documentation": "The same use-case sequence contains modification request or confirmed deletion; the common response below completes whichever existing operation was selected.",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_cef892d973dc4f8bad1d624632edea11",
													"_parent": {
														"$ref": "MWT_UC7_105169ab585a4d118853ca2a6f5b65b8"
													},
													"guard": "Modify requested"
												},
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_7c1a23725bda4e94ab6acdf5e2a4a805",
													"_parent": {
														"$ref": "MWT_UC7_105169ab585a4d118853ca2a6f5b65b8"
													},
													"guard": "Delete confirmed"
												}
											]
										}
									],
									"documentation": "UC7 main flow at the same overview level as UC1/UC2. An authenticated Employee loads/selects a current product and chooses the existing modification or confirmed-deletion UI operation. Modification retains the UI default preview. Both existing APIs call RunTravelTransaction with existing work; FindProduct and HasApplications run under the same product lock. Applications explicitly refuse changes. Modification retains ValidateProduct, canonical LoadDefaultConfiguration and ValidateConfiguration, and only passed validations reach UpdateProduct and successful commit. Configuration construction, repository forwarding and validation-error transaction unwinding are encapsulated. Failed validation stops writing/commit, aborts the existing transaction and prepares the existing correction ProductResult. Deletion normally returns true from DeleteProduct before confirmed commit; false means missing target, and DataAccessError is separate. After the selected alternative, one common ProductResult/UI completion returns the selected operation outcome. Unknown storage outcome is never assumed rollback or completion. All detailed exception/retry handling is in the footer; no invented operation/field/result code or work() arrow exists. All copied class declarations/signatures remain unchanged; the single use-case sequence and unnamed UI-to-actor completion are retained."
								}
							]
						},
