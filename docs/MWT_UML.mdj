											},
											"name": "filters",
											"type": "ProductFilter"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_DA_CLASS_TravelRepository_OP_FindProducts_RETURN",
											"_parent": {
												"$ref": "MWT_DA_CLASS_TravelRepository_OP_FindProducts"
											},
											"type": "List<TourProductData>",
											"direction": "return"
										}
									]
								},
								{
									"_type": "UMLOperation",
									"_id": "MWT_DA_CLASS_TravelRepository_OP_FindProduct",
									"_parent": {
										"$ref": "MWT_DA_CLASS_TravelRepository"
									},
									"name": "FindProduct",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_DA_CLASS_TravelRepository_OP_FindProduct_PARAM_productId",
											"_parent": {
												"$ref": "MWT_DA_CLASS_TravelRepository_OP_FindProduct"
											},
											"name": "productId",
											"type": "Integer"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_DA_CLASS_TravelRepository_OP_FindProduct_RETURN",
											"_parent": {
												"$ref": "MWT_DA_CLASS_TravelRepository_OP_FindProduct"
											},
											"type": "TourProductData",
											"multiplicity": "0..1",
											"direction": "return"
										}
									]
								},
								{
									"_type": "UMLOperation",
									"_id": "MWT_DA_CLASS_TravelRepository_OP_SaveProduct",
									"_parent": {
										"$ref": "MWT_DA_CLASS_TravelRepository"
									},
									"name": "SaveProduct",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_DA_CLASS_TravelRepository_OP_SaveProduct_PARAM_product",
											"_parent": {
