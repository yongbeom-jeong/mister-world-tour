						{
							"_type": "UMLInterface",
							"_id": "MWT_UI_API_TravelManagementAPI",
							"_parent": {
								"$ref": "MWT_ARCH_TRAVEL"
							},
							"name": "TravelManagementAPI",
							"documentation": "여행 상품·구성·가격·신청·이력·직원 상품 관리 제공 인터페이스. 기존 UI가 참조하는 동일한 인터페이스에 연산을 추가한다.",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MWT_UI_API_TravelManagementAPI_OP_ViewPreviousTravelHistory",
									"_parent": {
										"$ref": "MWT_UI_API_TravelManagementAPI"
									},
									"name": "ViewPreviousTravelHistory",
									"documentation": "서버 세션으로 확인한 고객의 이전 여행 이력을 완료일 기준 최근 순으로 반환한다.",
									"parameters": [
