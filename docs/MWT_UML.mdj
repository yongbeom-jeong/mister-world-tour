											},
											"name": "LoadDefaultConfiguration(theme, level)",
											"source": {
												"$ref": "MWT_UC6_USER"
											},
											"target": {
												"$ref": "MWT_UC6_MWT"
											},
											"sequenceNumber": "3-1",
											"documentation": "직원이 테마와 초기 투어 등급을 선택하여 기본 구성안을 요청한다. TourProductAdminView의 기존 LoadDefaultConfiguration 연산을 사용한다."
										},
										{
											"_type": "UMLMessage",
											"_id": "MWT_UC6_NEWMSG_3",
											"_parent": {
												"$ref": "MWT_UC6_INTERACTION"
											},
											"name": "LoadDefaultConfiguration(theme, level)",
											"source": {
												"$ref": "MWT_UC6_MWT"
											},
											"target": {
												"$ref": "MWT_UC6_MWT"
											},
											"sequenceNumber": "3-2",
											"documentation": "선택한 테마·등급에 맞는 기본 구성을 생성한다. 등록 요청 전에 수행한다."
										},
										{
											"_type": "UMLMessage",
											"_id": "MWT_UC6_NEWMSG_4",
											"_parent": {
												"$ref": "MWT_UC6_INTERACTION"
