											},
											"type": {
												"$ref": "MWT_MM_CLASS_Member"
											},
											"direction": "return"
										}
									]
								},
								{
									"_type": "UMLOperation",
									"_id": "MWT_DA_CLASS_MemberRepository_OP_FindMemberByAccount",
									"_parent": {
										"$ref": "MWT_DA_CLASS_MemberRepository"
