												{
													"_type": "UMLPseudostate",
													"_id": "AAAAAAGhLrygHycJzcU=",
													"_parent": {
														"$ref": "AAAAAAGhLrygACcD67Q="
													},
													"kind": "initial"
												},
												{
													"_type": "UMLState",
													"_id": "AAAAAAGhLrygLycahmU=",
													"_parent": {
														"$ref": "AAAAAAGhLrygACcD67Q="
													},
													"name": "Editing",
													"entryActivities": [
														{
															"_type": "UMLOpaqueBehavior",
