												"$ref": "MWT_UC7_92eb614f7e754e918c3826c45f458752"
											},
											"interactionOperator": "opt",
											"documentation": "Failure skips UpdateProduct and successful commit; transaction abort/error unwinding is encapsulated and described in the footer.",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC7_f41bc0c384a54f23aaf986b70e0ccd37",
