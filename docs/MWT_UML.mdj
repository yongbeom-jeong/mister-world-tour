									"documentation": "저장 후 부여되는 상품 번호.",
									"visibility": "private",
									"type": "Integer",
									"multiplicity": "0..1"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_productName",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "productName",
									"documentation": "상품 이름.",
									"visibility": "private",
									"type": "String"
								},
								{
									"_type": "UMLAttribute",
