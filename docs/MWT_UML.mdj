											},
											"represent": {
												"$ref": "MWT_UC8_SYSTEM_ROLE"
											}
										}
									],
									"documentation": "분석산출물 UC3·UC4·UC5의 액터/:MWT 및 자기 메시지 표현 방식에 맞춘 시퀀스도. 함수·매개변수는 설계산출물을 참고한다. 번호는 유스케이스 주 흐름 단계와 대응한다. 분기의 대안 번호는 5.1/5.2처럼 점으로, 순차적인 세부 처리 번호는 4-1/4-2처럼 하이픈으로 구분한다. 이는 이 문서의 사용자 지정 번호 규칙이다. 일반 오류 부 흐름은 설명서를 따른다.",
									"fragments": [
										{
											"_type": "UMLCombinedFragment",
											"_id": "MWT_UC8_SPRING_FRAG_1",
											"_parent": {
												"$ref": "MWT_UC8_INTERACTION"
											},
											"interactionOperator": "opt",
											"operands": [
												{
													"_type": "UMLInteractionOperand",
													"_id": "MWT_UC8_SPRING_FRAG_2",
													"_parent": {
														"$ref": "MWT_UC8_SPRING_FRAG_1"
													},
													"guard": "item management selected"
												}
											]
										}
									]
								}
							],
