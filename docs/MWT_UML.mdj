											},
											"target": {
												"$ref": "MWT_UC6_USER"
											},
											"sequenceNumber": "3-3",
											"documentation": "직원에게 기본 구성안을 보여주어 확인하고 선택할 수 있게 한다.",
											"messageSort": "reply"
										},
										{
											"_type": "UMLMessage",
											"_id": "MWT_UC6_NEWMSG_5",
											"_parent": {
												"$ref": "MWT_UC6_INTERACTION"
											},
											"name": "RegisterTourProduct(productName, theme, level, destination, description, basePrice, travelPeriod, departureDate, image)",
											"source": {
												"$ref": "MWT_UC6_USER"
											},
											"target": {
												"$ref": "MWT_UC6_MWT"
											},
											"sequenceNumber": "3-4",
											"documentation": "직원이 기본 구성안을 확인·선택한 뒤 가격·여행 기간·출발일을 입력하여 등록을 요청한다. 테마·등급은 확인한 구성안과 동일한 선택값이다."
										},
										{
											"_type": "UMLMessage",
