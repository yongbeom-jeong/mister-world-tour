                  },
                  "target": {
                    "$ref": "MWT_UC7_MWT"
                  },
                  "sequenceNumber": "6-1",
                  "documentation": ""
                },
                {
                  "_type": "UMLMessage",
                  "_id": "MWT_UC7_NEWMSG_9",
                  "_parent": {
                    "$ref": "MWT_UC7_INTERACTION"
                  },
                  "name": "ValidateProduct()",
