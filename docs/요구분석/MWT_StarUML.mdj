							"messages": [
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_1",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "SelectSouvenirStockReceipt()",
									"documentation": "주 흐름 1: 직원이 기념품 입고 등록을 선택한다.",
									"source": {
										"$ref": "MWT_UC8_USER"
									},
									"target": {
										"$ref": "MWT_UC8_MWT"
									},
									"sequenceNumber": "1"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_2",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "ShowSouvenirsAndCurrentStock()",
									"documentation": "주 흐름 2: 미리 등록된 기념품 목록·현재 재고·입력 화면을 표시한다. 재고 없는 품목은 0개로 표시한다. 조회 실패는 0으로 표시하지 않는다.",
									"source": {
										"$ref": "MWT_UC8_MWT"
									},
									"target": {
										"$ref": "MWT_UC8_USER"
									},
									"sequenceNumber": "2"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_3",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "InputStockReceipt(item, quantity)",
									"documentation": "주 흐름 3: 기념품을 선택하고 입고 수량을 입력하여 등록을 요청한다.",
									"source": {
										"$ref": "MWT_UC8_USER"
									},
									"target": {
										"$ref": "MWT_UC8_MWT"
									},
									"sequenceNumber": "3"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_4",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "ValidateStockReceipt()",
									"documentation": "주 흐름 4: 선택한 품목과 수량을 검사한다. 입고 수량은 1 이상의 정수여야 한다.",
									"source": {
										"$ref": "MWT_UC8_MWT"
									},
									"target": {
										"$ref": "MWT_UC8_MWT"
									},
									"sequenceNumber": "4"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_5",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "SaveReceiptAndAddStock(quantity)",
									"documentation": "주 흐름 5: 입고 내역을 저장하고 해당 물품의 재고에 입고 수량을 더한다. 기존 재고를 입고 수량으로 덮어쓰지 않는다.",
									"source": {
										"$ref": "MWT_UC8_MWT"
									},
									"target": {
										"$ref": "MWT_UC8_MWT"
									},
									"sequenceNumber": "5"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_MSG_6",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"name": "ShowReceiptResultAndUpdatedStock()",
									"documentation": "주 흐름 6: 입고 결과와 변경된 재고를 보여준다.",
									"source": {
										"$ref": "MWT_UC8_MWT"
									},
									"target": {
										"$ref": "MWT_UC8_USER"
									},
									"sequenceNumber": "6"
								}
							],
							"participants": [
								{
									"_type": "UMLLifeline",
									"_id": "MWT_UC8_USER",
									"_parent": {
										"$ref": "MWT_UC8_INTERACTION"
									},
									"represent": {
										"$ref": "MWT_UC8_ACTOR_ROLE"
									}
								},
								{
									"_type": "UMLLifeline",
									"_id": "MWT_UC8_MWT",
