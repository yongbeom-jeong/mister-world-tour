										"$ref": "MWT_UC8_INTERACTION"
									},
									"represent": {
										"$ref": "MWT_UC8_SYSTEM_ROLE"
									}
								}
							]
						}
					],
					"attributes": [
						{
							"_type": "UMLAttribute",
							"_id": "MWT_UC8_ACTOR_ROLE",
							"_parent": {
								"$ref": "MWT_UC8_COLLAB"
							},
							"name": "employee",
							"type": {
								"$ref": "MWT_UC8_ACTOR"
							}
						},
						{
							"_type": "UMLAttribute",
							"_id": "MWT_UC8_SYSTEM_ROLE",
							"_parent": {
								"$ref": "MWT_UC8_COLLAB"
							},
							"name": "system",
							"type": "MWT"
						}
					]
				}
			],
			"documentation": "진리 MD에 따른 UC1·UC2·UC6·UC7·UC8의 시퀀스도 5개. UC2는 로그인 주 흐름 1~4단계만 표시한다. 직원과 MWT의 상호작용 및 UC7의 신청 상품 수정 금지 분기를 포함한다."
		},
