              },
              "name": "Confirm Deletion?"
            },
            {
              "_type": "UMLAction",
              "_id": "MWT_OVERALL_DELETE_PRODUCT",
              "_parent": {
                "$ref": "MWT_OVERALL_ACTIVITY"
