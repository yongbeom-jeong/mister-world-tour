										{
											"_type": "UMLTextView",
											"_id": "MWT_UC6_8799efca03f4471bb33db5258a517624",
											"_parent": {
												"$ref": "MWT_UC6_be0887b8c5b741518704808aa8f87b67"
											},
											"left": 20,
											"top": 1597,
											"width": 2340,
											"height": 110,
											"text": "Invalid input/configuration: return correction information without saving; correct and resubmit.\nStorage failure: retry only if the product is confirmed not saved. If unknown, end without reporting completion or saving again.",
											"font": "Arial;14;0",
											"parentStyle": false,
											"showShadow": false
										}
									],
									"showSequenceNumber": false
								}
							],
							"documentation": "UC6 main flow at the same overview level as UC1/UC2. An authenticated Employee opens registration, previews defaults and submits through the existing UI methods. TravelManager maps input to TravelProduct and calls ValidateProduct. Only product-validation success regenerates canonical defaultConfiguration through existing LoadDefaultConfiguration; constructor and registered-souvenir lookup are encapsulated. ValidateConfiguration is retained explicitly. Only both successful validations call DataAccessManager.SaveProduct. Repository forwarding is encapsulated. A common ProductResult return represents either confirmed registration or correction information; validation failures perform no storage. Storage failures and unknown outcomes terminate/return error as specified in the footer. No new operation, field or status code is added, all copied class declarations/signatures remain unchanged, and UI-to-actor replies are unnamed.",
							"messages": [
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC6_de392935cb95460bbe9e06378c1263e4",
									"_parent": {
										"$ref": "MWT_UC6_6f5aaac6e61a47fb92baf6a8bf67d057"
									},
									"source": {
										"$ref": "MWT_UC6_81f69f6bff0b4da3a2d1c3b9a253b807"
									},
									"target": {
										"$ref": "MWT_UC6_c49c68c0a4d84545b81a2932d9d8f8c6"
									},
									"sequenceNumber": "1",
									"documentation": "",
									"name": "ShowRegistration()",
									"signature": {
										"$ref": "MWT_UC6_eb9c85e5e1d34d3ca22cfaa4193481e2"
									}
								},
								{
