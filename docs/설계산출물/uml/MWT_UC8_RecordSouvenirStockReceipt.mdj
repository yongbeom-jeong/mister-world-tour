{
	"_type": "Project",
	"_id": "MWT_UC8_cb2b97df8f9f4161b3f87320af490850",
	"name": "Mister World Tour UC8 Record Souvenir Stock Receipt Design",
	"documentVersion": 1,
	"documentation": "UC8 uses only existing design classes, signatures and logical results. Repository delegation and documented error details are abstracted. Existing validation results use natural policy guards; no new field or result code is invented.",
	"ownedElements": [
		{
			"_type": "UMLModel",
			"_id": "MWT_UC8_a4cf01f8154141f88d783d0f6a4bd4bc",
