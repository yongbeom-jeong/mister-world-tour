							},
							"name": "ExistsAccount",
							"parameters": [
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC8_d85dd6533f8541b5aae34f5866cc90a5",
									"_parent": {
										"$ref": "MWT_UC8_3da27c5dc03e4d3eb18accb547e0f3f1"
									},
									"name": "account",
									"type": "String"
								},
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC8_4bcbb8b473f14b5ab31e0c14139987e4",
									"_parent": {
										"$ref": "MWT_UC8_3da27c5dc03e4d3eb18accb547e0f3f1"
									},
									"type": "Boolean",
									"direction": "return"
								}
							]
						},
