								"$ref": "MWT_UC8_d505fbff937b45fba66510ce1229df4b"
							},
							"name": "SaveDepartureStatus",
							"parameters": [
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC8_5bf032e79a6c4830ab4250a2855b918b",
									"_parent": {
										"$ref": "MWT_UC8_2d3a1f3bc0a546319bded73496f3ee2c"
									},
									"name": "productId",
									"type": "Integer"
								},
