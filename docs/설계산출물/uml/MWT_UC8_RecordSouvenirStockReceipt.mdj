									},
									"sequenceNumber": "21",
									"documentation": "Only matching prepared context, valid original receipt and existing current item reach the existing atomic receipt/stock save. The shown normal return is confirmed commit; rollback/unknown outcomes are encapsulated by the existing registration procedure and explained below.",
									"name": "SaveStockReceipt(receipt)",
									"signature": {
										"$ref": "MWT_UC8_1bdce1c45d6d44af909e3543db5d9a67"
									}
								},
								{
