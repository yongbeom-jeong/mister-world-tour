									},
									"sequenceNumber": "24",
									"documentation": "Normal declared API return. Repository delegation is encapsulated by DataAccessManager; errors follow the footer and do not count as a normal empty/false result.",
									"name": "SouvenirData",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_12318dfd1c57457e9ea54e50488fc16e",
									"_parent": {
										"$ref": "MWT_UC8_20188379625546c3b9ec1110b3665100"
									},
									"source": {
										"$ref": "MWT_UC8_16d4978fe768400081ee7e0f4f968434"
									},
									"target": {
										"$ref": "MWT_UC8_26d15ceb5a334a1db4f09a92f12ce31f"
									},
									"sequenceNumber": "25",
									"documentation": "Common existing response: confirmed receipt success retains receipt, currentSouvenir and stockRefreshSucceeded according to stock refresh; mismatch returns request conflict, invalid receipt/context/item returns the appropriate existing failure, and unresolved storage remains unknown. No unverified receipt/current stock is fabricated. Common outcome construction and exception handling are internal assignments of the existing API, not new operations or fields.",
									"name": "StockReceiptResponse",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_3a9c848fb2da4cd6a0eb4b00bd4cb6a4",
									"_parent": {
										"$ref": "MWT_UC8_20188379625546c3b9ec1110b3665100"
									},
									"source": {
										"$ref": "MWT_UC8_26d15ceb5a334a1db4f09a92f12ce31f"
									},
									"target": {
										"$ref": "MWT_UC8_240feffe86f54a30ac0966bc6f0eb6e6"
									},
									"sequenceNumber": "26",
									"documentation": "Use the existing currentSouvenir only when returned stockRefreshSucceeded=true; update existing selectedSouvenir/souvenirList. A real stock quantity of zero is valid.",
									"name": "GetStockQuantity()",
									"signature": {
										"$ref": "MWT_UC8_53145b606fd84193b8d761efa8c3158e"
									}
								},
								{
									"_type": "UMLMessage",
