									"sequenceNumber": "22",
									"documentation": "Normal declared API return. Repository delegation is encapsulated by DataAccessManager; errors follow the footer and do not count as a normal empty/false result.",
									"name": "StockReceiptResult",
									"messageSort": "reply"
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_b21ed6a03e404c34aa1d88aaf9751a72",
									"_parent": {
										"$ref": "MWT_UC8_20188379625546c3b9ec1110b3665100"
