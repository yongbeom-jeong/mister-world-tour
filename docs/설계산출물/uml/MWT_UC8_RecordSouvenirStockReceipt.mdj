									},
									"sequenceNumber": "23",
									"documentation": "Only after verified receipt success, reload current stock. Normal item data maps to existing currentSouvenir and stockRefreshSucceeded=true. Missing item or DataAccessError is caught by the existing manager procedure: preserve receipt success, leave currentSouvenir absent and set stockRefreshSucceeded=false; the refresh-failure detail is in the footer.",
									"name": "FindSouvenir(souvenirId)",
									"signature": {
										"$ref": "MWT_UC8_4c49579acc0745ab8da618d6e4d26ed5"
									}
								},
								{
									"_type": "UMLMessage",
									"_id": "MWT_UC8_7f82540fcab64c99a3aedbdcfd277173",
									"_parent": {
