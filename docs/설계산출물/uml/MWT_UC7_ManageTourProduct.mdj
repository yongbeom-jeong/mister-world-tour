					"name": "SMSNotificationAPI",
					"documentation": "Travel Management가 지정한 신청 고객과 확정 출발 정보를 받아 고객별 문자 발송 결과를 제공한다.",
					"operations": [
						{
							"_type": "UMLOperation",
							"_id": "MWT_UC7_99b4b4c0f4e74a1c8775b0933bbc9ae6",
							"_parent": {
								"$ref": "MWT_UC7_04f95c8cc40d40de8060f916bb004758"
							},
							"name": "SendDepartureConfirmation",
							"documentation": "Travel Management가 확정·선정한 고객에게 문자를 발송한다. 대상별 최초 1회와 명확한 실패의 재시도 최대 3회를 관리하며 성공·실패·결과 불명을 반환한다.",
							"parameters": [
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC7_ca1e1e5bee504bddabb8197606946ca3",
									"_parent": {
										"$ref": "MWT_UC7_99b4b4c0f4e74a1c8775b0933bbc9ae6"
									},
									"name": "recipients",
									"type": "List<SMSRecipient>"
								},
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC7_0909f351c1a74725a8595acdf0c2b04a",
									"_parent": {
										"$ref": "MWT_UC7_99b4b4c0f4e74a1c8775b0933bbc9ae6"
									},
									"name": "notice",
									"type": "DepartureNotice"
								},
								{
									"_type": "UMLParameter",
									"_id": "MWT_UC7_fa828f9972154ce4b1c9f35a4e4cc105",
									"_parent": {
