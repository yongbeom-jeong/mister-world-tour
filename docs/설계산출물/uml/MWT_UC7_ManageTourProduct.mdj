						{
							"_type": "UMLUseCaseSubject",
							"_id": "MWT_UC7_1cb321887e424ce69365268d24d352ca",
							"_parent": {
								"$ref": "MWT_UC7_d8580b03e8da45b1bcfcffa4df4e68e6"
							},
							"name": "Mister World Tour",
							"ownedElements": [
								{
									"_type": "UMLUseCase",
									"_id": "MWT_UC7_4a522402e6974cfc8eebf6b4a298d22f",
									"_parent": {
										"$ref": "MWT_UC7_1cb321887e424ce69365268d24d352ca"
									},
									"name": "MWT-UC7 Manage Tour Product",
									"documentation": "UC7 main flow at the same overview level as UC1/UC2. An authenticated Employee loads/selects a current product and chooses the existing modification or confirmed-deletion UI operation. Modification retains the UI default preview. Both existing APIs call RunTravelTransaction with existing work; FindProduct and HasApplications run under the same product lock. Applications explicitly refuse changes. Modification retains ValidateProduct, canonical LoadDefaultConfiguration and ValidateConfiguration, and only passed validations reach UpdateProduct and successful commit. Configuration construction, repository forwarding and validation-error transaction unwinding are encapsulated. Failed validation stops writing/commit, aborts the existing transaction and prepares the existing correction ProductResult. Deletion normally returns true from DeleteProduct before confirmed commit; false means missing target, and DataAccessError is separate. After the selected alternative, one common ProductResult/UI completion returns the selected operation outcome. Unknown storage outcome is never assumed rollback or completion. All detailed exception/retry handling is in the footer; no invented operation/field/result code or work() arrow exists. All copied class declarations/signatures remain unchanged; the single use-case sequence and unnamed UI-to-actor completion are retained."
								}
							]
						},
