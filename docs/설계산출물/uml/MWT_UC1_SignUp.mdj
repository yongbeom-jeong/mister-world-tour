								},
								{
									"_type": "UMLNoteView",
									"_id": "MWT_UC1_b21422922950463285b42e043eeef283",
									"_parent": {
										"$ref": "MWT_UC1_d41b2aa16a3b4c43a9d685f5d016c653"
									},
									"fillColor": "#FFFFFF",
									"font": "Malgun Gothic;16;0",
									"parentStyle": false,
									"showShadow": false,
									"left": 310,
									"top": 510,
									"width": 960,
									"height": 110,
									"text": "MWT-UC1 Sign Up: Customer and Employee register an account, profile and selected role.\nNo precondition. Success requires verified storage of this registration.\nInvalid input or a duplicate account permits correction and another SignUp() request.\nA storage error requires verification before retry or termination."
								}
							]
						},
						{
							"_type": "UMLUseCaseSubject",
							"_id": "MWT_UC1_faf21605c3104af6bbb956767564b32b",
							"_parent": {
								"$ref": "MWT_UC1_5d9297363eb14fa09edbea903f85db3f"
							},
							"name": "Mister World Tour",
							"ownedElements": [
								{
									"_type": "UMLUseCase",
									"_id": "MWT_UC1_319482b215904a6cb035c223a0d26eb6",
									"_parent": {
										"$ref": "MWT_UC1_faf21605c3104af6bbb956767564b32b"
									},
									"name": "MWT-UC1 Sign Up",
									"documentation": "Analysis document section 3.1, MWT-UC1 Sign Up\nActors: Customer and Employee. Precondition: none.\nPostconditions: the account, name, address and contact are stored; the role matches the selected member type.\nMain flow: (1) select Sign Up; (2) display member type and registration fields; (3) submit member type and registration information; (4) validate input and account uniqueness; (5) store the account, profile and role; (6) display the registration result.\nAlternative 4a: input error or duplicate account; show the fields to correct and return to step (3).\nAlternative 5a: persistence error; verify whether registration was stored, then retry or end. Never report success without verifying registration.\nDesign refinements: password input, password hashing, Member construction and DataAccessAPI delegation implement these steps. Successful sign up does not automatically log in."
								}
							]
						},
