							],
							"fragments": [
								{
									"_type": "UMLCombinedFragment",
									"_id": "MWT_UC2_578947e89e5f422e9e173467396f5431",
									"_parent": {
										"$ref": "MWT_UC2_bb36c2c59ee047ce83289704bdf36ccb"
									},
									"documentation": "For a normally returned member, member != null permits CheckPassword. A null member skips the password check. Lookup errors return an error result and stop authentication before any Member call, as described below the diagram. The following authentication alt determines the normal lookup outcome.",
									"interactionOperator": "opt",
									"operands": [
										{
											"_type": "UMLInteractionOperand",
											"_id": "MWT_UC2_ea79d6351ea24a65b1069397dcbb308b",
											"_parent": {
												"$ref": "MWT_UC2_578947e89e5f422e9e173467396f5431"
											},
											"guard": "member != null"
										}
									]
								},
								{
									"_type": "UMLCombinedFragment",
									"_id": "MWT_UC2_4336bc9c729c461681ea2c1982da3d8e",
									"_parent": {
										"$ref": "MWT_UC2_bb36c2c59ee047ce83289704bdf36ccb"
									},
									"documentation": "Success retrieves memberId and role, creates and stores LoginSession, returns a successful LoginResult and opens the role home. Only customers start UC3. The else operand returns a failure without opening a session, home or history. Lookup errors remain distinguishable from invalid credentials in the existing LoginResult.",
									"interactionOperator": "alt",
									"operands": [
										{
											"_type": "UMLInteractionOperand",
											"_id": "MWT_UC2_0add0a5fbc1f4ac38c769b2331d6953a",
											"_parent": {
												"$ref": "MWT_UC2_4336bc9c729c461681ea2c1982da3d8e"
											},
											"guard": "member != null and passwordVerified = true"
										},
										{
											"_type": "UMLInteractionOperand",
											"_id": "MWT_UC2_ae773395099a4f988b9456b745c63e7f",
											"_parent": {
												"$ref": "MWT_UC2_4336bc9c729c461681ea2c1982da3d8e"
											},
											"guard": "else"
										}
									]
								},
								{
									"_type": "UMLCombinedFragment",
									"_id": "MWT_UC2_e41b9d3203f84595988efd7e9a7ed484",
									"_parent": {
										"$ref": "MWT_UC2_bb36c2c59ee047ce83289704bdf36ccb"
									},
									"documentation": "Successful customer login starts UC3. Employee login skips this operand. History errors and popup closure preserve successful authentication.",
									"interactionOperator": "opt",
									"operands": [
										{
											"_type": "UMLInteractionOperand",
											"_id": "MWT_UC2_a879a6b368fd469ab80af83eb1087e9c",
											"_parent": {
												"$ref": "MWT_UC2_e41b9d3203f84595988efd7e9a7ed484"
											},
											"guard": "role = Customer"
										}
									]
								}
							]
						}
					],
