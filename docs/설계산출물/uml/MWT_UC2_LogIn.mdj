									"name": "loginResult",
									"documentation": "Alternative 2a: return the existing LoginResult indicating failure. Distinguish invalid credentials from lookup errors. No LoginSession, home or history is opened.",
									"source": {
										"$ref": "MWT_UC2_4e56b966001c40ccb9cfb928243c007b"
									},
									"target": {
