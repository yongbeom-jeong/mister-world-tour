						},
						{
							"_type": "UMLUseCaseSubject",
							"_id": "MWT_UC2_373acff9e0574f01ac3e73b1ee61b4b4",
							"_parent": {
								"$ref": "MWT_UC2_5fa39af1f968492a9ffc268e79d80b99"
							},
							"name": "Mister World Tour",
							"ownedElements": [
								{
									"_type": "UMLUseCase",
									"_id": "MWT_UC2_219ad49e9e4c4c158146ee580df2a1e0",
									"_parent": {
										"$ref": "MWT_UC2_373acff9e0574f01ac3e73b1ee61b4b4"
									},
									"name": "MWT-UC2 Log In",
									"documentation": "Analysis document section 3.2, MWT-UC2 Log In\nActors: Customer and Employee. Precondition: the account is registered.\nPostconditions: the user is authenticated and can access functions permitted for the verified role.\nMain flow: (1) submit credentials; (2) authenticate the account; (3) identify the authenticated role and permissions; (4) display role functions. A customer automatically starts MWT-UC3 at step (2).\nAlternative 2a: authentication failure; show an error and return to step (1).\nAlternative 4a: employee login displays the employee interface without a history popup.\nAlternative 4b: history lookup failure follows MWT-UC3 error handling and preserves successful authentication.\nRelationship from the analysis StarUML model: MWT-UC3 extends Log In when user role = Customer. Sign Up is a precondition of Log In, not an included action performed during every login."
								},
								{
									"_type": "UMLUseCase",
									"_id": "MWT_UC2_fa925960723c413a88f76015f5cb6d3d",
									"_parent": {
										"$ref": "MWT_UC2_373acff9e0574f01ac3e73b1ee61b4b4"
									},
									"name": "MWT-UC3 View Travel History",
									"ownedElements": [
										{
											"_type": "UMLExtend",
											"_id": "MWT_UC2_a88feebf7b174498ad74bd005df46634",
											"_parent": {
												"$ref": "MWT_UC2_fa925960723c413a88f76015f5cb6d3d"
											},
											"documentation": "Preserved from the analysis model. Extend direction is View Travel History to Log In. The extension occurs after successful authentication when the user role is Customer.",
											"source": {
												"$ref": "MWT_UC2_fa925960723c413a88f76015f5cb6d3d"
											},
											"target": {
												"$ref": "MWT_UC2_219ad49e9e4c4c158146ee580df2a1e0"
											},
											"condition": "{user role = Customer}"
										}
									],
									"documentation": "Analysis document section 3.3, MWT-UC3 View Travel History\nActor: Customer. Precondition: successful customer authentication.\nMain flow: (1) select history manually, or start automatically after customer login at step (2); (2) retrieve this customer history; (3) get product, period, tour grade and price; (4) order most recent first; (5) show the popup; (6) close the popup or continue.\nAlternative 2a: show an explicit no-history popup, then continue to step (6).\nAlternative 2b: distinguish a lookup failure from no history. Retry returns to step (2); closing keeps the user authenticated.\nThis related use case is shown to preserve the conditional extension defined in the analysis model. Its full data retrieval design remains in MWT-UC3."
								}
							]
						},
