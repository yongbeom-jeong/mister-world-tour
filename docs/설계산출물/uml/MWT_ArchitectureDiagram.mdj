                      "_parent": {
                        "$ref": "MWT_DA_CLASS_SouvenirRepository_OP_SaveStockReceipt"
                      },
                      "type": "StockReceiptResult",
                      "direction": "return"
                    }
                  ]
                },
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_DA_CLASS_SouvenirRepository_OP_FindStockReceiptByRequestKey",
                  "_parent": {
                    "$ref": "MWT_DA_CLASS_SouvenirRepository"
