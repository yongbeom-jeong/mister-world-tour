				{
					"_type": "UMLPackage",
					"_id": "MWT_ARCH_SPEECH",
					"_parent": {
						"$ref": "MWT_ARCH_MODEL"
					},
					"name": "Speech Recognition Integration",
					"ownedElements": [
						{
							"_type": "UMLInterface",
							"_id": "MWT_UI_API_SpeechRecognitionAPI",
							"_parent": {
								"$ref": "MWT_ARCH_SPEECH"
							},
							"name": "SpeechRecognitionAPI",
							"documentation": "UI의 음성 입력과 현재 선택 문맥을 받아 테마·투어 등급 조회 조건 또는 상품 선택 해석 결과를 제공한다.",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection",
									"_parent": {
										"$ref": "MWT_UI_API_SpeechRecognitionAPI"
									},
									"name": "RecognizeSelection",
									"documentation": "음성 인식과 선택 해석을 연결하며 UI에 성공·실패·모호·미지원 결과를 반환한다. 실패를 기록하고 고객 재입력을 지원한다.",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection_PARAM_voiceInput",
											"_parent": {
												"$ref": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection"
											},
											"name": "voiceInput",
											"type": "VoiceInput"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection_PARAM_context",
											"_parent": {
												"$ref": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection"
											},
											"name": "context",
											"type": "VoiceSelectionContext"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection_RETURN",
											"_parent": {
												"$ref": "MWT_UI_API_SpeechRecognitionAPI_OP_RecognizeSelection"
											},
											"type": "VoiceSelectionResult",
											"direction": "return"
										}
									]
								}
							]
						},
						{
							"_type": "UMLClass",
							"_id": "MWT_SR_CLASS_SpeechRecognitionManager",
							"_parent": {
								"$ref": "MWT_ARCH_SPEECH"
							},
							"name": "SpeechRecognitionManager",
							"documentation": "SpeechRecognitionAPI를 실현한다. 요청마다 전달된 음성과 문맥을 사용하여 외부 인식과 선택 해석을 연결하며 실패를 애플리케이션 로그에 기록한다. 공유 사용자 상태는 보관하지 않는다.",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection",
									"_parent": {
										"$ref": "MWT_SR_CLASS_SpeechRecognitionManager"
									},
									"name": "RecognizeSelection",
									"documentation": "음성 인식과 선택 해석을 연결하며 UI에 성공·실패·모호·미지원 결과를 반환한다. 실패를 기록하고 고객 재입력을 지원한다.",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection_PARAM_voiceInput",
											"_parent": {
												"$ref": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection"
											},
											"name": "voiceInput",
											"type": "VoiceInput"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection_PARAM_context",
											"_parent": {
												"$ref": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection"
											},
											"name": "context",
											"type": "VoiceSelectionContext"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection_RETURN",
											"_parent": {
												"$ref": "MWT_SR_CLASS_SpeechRecognitionManager_OP_RecognizeSelection"
											},
											"type": "VoiceSelectionResult",
											"direction": "return"
										}
									]
								}
							]
						},
						{
							"_type": "UMLClass",
							"_id": "MWT_SR_CLASS_SpeechServiceClient",
							"_parent": {
								"$ref": "MWT_ARCH_SPEECH"
							},
							"name": "SpeechServiceClient",
							"documentation": "외부 한국어 음성인식 API를 호출하고 응답·오류를 내부 인식 결과로 변환한다. 상품 선택 의미를 판단하거나 자체 자동 재시도를 수행하지 않는다. 업체·접속 설정·전송 형식은 후속 구현에서 정한다.",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MWT_SR_CLASS_SpeechServiceClient_OP_Recognize",
									"_parent": {
										"$ref": "MWT_SR_CLASS_SpeechServiceClient"
									},
									"name": "Recognize",
									"documentation": "외부 한국어 음성인식 서비스에 음성을 전송하여 인식 문장 또는 인식 불가·연동 실패 정보를 반환한다.",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_SpeechServiceClient_OP_Recognize_PARAM_voiceInput",
											"_parent": {
												"$ref": "MWT_SR_CLASS_SpeechServiceClient_OP_Recognize"
											},
											"name": "voiceInput",
											"type": "VoiceInput"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_SpeechServiceClient_OP_Recognize_RETURN",
											"_parent": {
												"$ref": "MWT_SR_CLASS_SpeechServiceClient_OP_Recognize"
											},
											"type": "SpeechRecognitionResult",
											"direction": "return"
										}
									]
								}
							]
						},
						{
							"_type": "UMLClass",
							"_id": "MWT_SR_CLASS_VoiceSelectionInterpreter",
							"_parent": {
								"$ref": "MWT_ARCH_SPEECH"
							},
							"name": "VoiceSelectionInterpreter",
							"documentation": "인식 문장과 현재 테마·등급·상품 목록 문맥을 이용하여 명확한 조회 조건이나 상품 고유번호를 해석한다. 모호·미지원 결과에는 적용할 선택 값이 없으며 상품의 최종 업무 검증은 Travel Management가 수행한다.",
							"operations": [
								{
									"_type": "UMLOperation",
									"_id": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection",
									"_parent": {
										"$ref": "MWT_SR_CLASS_VoiceSelectionInterpreter"
									},
									"name": "InterpretSelection",
									"documentation": "인식 문장을 테마·등급 조회 조건 또는 상품 선택으로 해석한다. 명확한 하나의 선택을 특정할 수 없으면 모호·미지원 결과를 반환한다.",
									"parameters": [
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection_PARAM_recognizedText",
											"_parent": {
												"$ref": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection"
											},
											"name": "recognizedText",
											"type": "String"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection_PARAM_context",
											"_parent": {
												"$ref": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection"
											},
											"name": "context",
											"type": "VoiceSelectionContext"
										},
										{
											"_type": "UMLParameter",
											"_id": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection_RETURN",
											"_parent": {
												"$ref": "MWT_SR_CLASS_VoiceSelectionInterpreter_OP_InterpretSelection"
											},
											"type": "VoiceSelectionResult",
											"direction": "return"
										}
									]
								}
							]
						},
