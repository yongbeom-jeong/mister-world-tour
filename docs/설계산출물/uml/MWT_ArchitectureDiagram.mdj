        {
          "_type": "UMLPackage",
          "_id": "MWT_ARCH_MEMBER",
          "_parent": {
            "$ref": "MWT_ARCH_MODEL"
          },
          "name": "Member Management",
          "ownedElements": [
            {
              "_type": "UMLInterface",
              "_id": "MWT_UI_API_MemberManagementAPI",
              "_parent": {
                "$ref": "MWT_ARCH_MEMBER"
              },
              "name": "MemberManagementAPI",
              "documentation": "User Interface가 요청하는 자체 아이디·비밀번호 가입·로그인의 제공 계약. MemberManager가 실현한다.",
              "operations": [
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp",
                  "_parent": {
                    "$ref": "MWT_UI_API_MemberManagementAPI"
                  },
                  "name": "SignUp",
                  "visibility": "public",
                  "parameters": [
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_memberType",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "memberType",
                      "type": "MemberType",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_account",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "account",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_password",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "password",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_name",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "name",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_address",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "address",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_PARAM_contact",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "contact",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_SignUp_RETURN",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_SignUp"
                      },
                      "name": "",
                      "type": "SignUpResult",
                      "direction": "return"
                    }
                  ],
                  "documentation": ""
                },
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_UI_API_MemberManagementAPI_OP_LogIn",
                  "_parent": {
                    "$ref": "MWT_UI_API_MemberManagementAPI"
                  },
                  "name": "LogIn",
                  "visibility": "public",
                  "parameters": [
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_LogIn_PARAM_loginInfo",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_LogIn"
                      },
                      "name": "loginInfo",
                      "type": "LoginCredentials",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_UI_API_MemberManagementAPI_OP_LogIn_RETURN",
                      "_parent": {
                        "$ref": "MWT_UI_API_MemberManagementAPI_OP_LogIn"
                      },
                      "name": "",
                      "type": "LoginResult",
                      "direction": "return"
                    }
                  ],
                  "documentation": ""
                }
              ]
            },
            {
              "_type": "UMLClass",
              "_id": "MWT_MM_CLASS_MemberManager",
              "_parent": {
                "$ref": "MWT_ARCH_MEMBER"
              },
              "name": "MemberManager",
              "documentation": "가입·로그인 처리 순서를 관리하는 무상태 클래스. 계정 중복 확인·회원 저장·아이디 조회는 Data Access에 요청한다. MemberType을 Role에 대응시키며 가입 시 비밀번호 해시를 생성한다. 로그인에서 Member.CheckPassword() 호출에 성공하면 회원 식별값과 역할로 LoginSession을 생성하고 요청 사용자의 서버 세션에 보관한다. 고객 이력 팝업은 UI와 Travel Management가 처리한다.",
              "attributes": [],
              "operations": [
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_MemberManager"
                  },
                  "name": "SignUp",
                  "visibility": "public",
                  "parameters": [
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_memberType",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "memberType",
                      "type": "MemberType",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_account",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "account",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_password",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "password",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_name",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "name",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_address",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "address",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_PARAM_contact",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "contact",
                      "type": "String",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_SignUp_RETURN",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_SignUp"
                      },
                      "name": "",
                      "type": "SignUpResult",
                      "direction": "return"
                    }
                  ],
                  "documentation": "필수 입력·회원 유형을 검증하고 아이디 중복을 확인한다. 비밀번호 해시와 역할로 Member를 구성하여 Data Access에 저장한다. 성공 여부, 안내 메시지, 수정할 입력 항목을 반환한다."
                },
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_MM_CLASS_MemberManager_OP_LogIn",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_MemberManager"
                  },
                  "name": "LogIn",
                  "visibility": "public",
                  "parameters": [
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_LogIn_PARAM_loginInfo",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_LogIn"
                      },
                      "name": "loginInfo",
                      "type": "LoginCredentials",
                      "direction": "in"
                    },
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_MemberManager_OP_LogIn_RETURN",
                      "_parent": {
                        "$ref": "MWT_MM_CLASS_MemberManager_OP_LogIn"
                      },
                      "name": "",
                      "type": "LoginResult",
                      "direction": "return"
                    }
                  ],
                  "documentation": "아이디로 저장된 Member를 조회하고 CheckPassword(password)를 호출한다. 성공 시 LoginSession을 생성하여 서버 프레임워크의 해당 사용자별 세션에 보관한다. 성공 여부·역할·안내 메시지를 반환하며 실패 시 역할은 없다."
                }
              ]
            },
            {
              "_type": "UMLClass",
              "_id": "MWT_MM_CLASS_Member",
              "_parent": {
                "$ref": "MWT_ARCH_MEMBER"
              },
              "name": "Member",
              "documentation": "고객·직원의 공통 회원 정보. 저장 전에는 memberId가 없을 수 있으며 로그인에서는 고유번호가 부여된 저장된 회원만 사용한다.",
              "attributes": [
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_memberId",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "memberId",
                  "visibility": "private",
                  "type": "Integer",
                  "multiplicity": "0..1",
                  "documentation": "저장 전 미부여, Data Access 저장 후 부여되는 회원 고유번호."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_account",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "account",
                  "visibility": "private",
                  "type": "String",
                  "multiplicity": "",
                  "documentation": "로그인 아이디."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_passwordHash",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "passwordHash",
                  "visibility": "private",
                  "type": "String",
                  "multiplicity": "",
                  "documentation": "가입 시 생성한 비밀번호 해시. 원문 비밀번호를 보관하지 않는다."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_name",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "name",
                  "visibility": "private",
                  "type": "String",
                  "multiplicity": "",
                  "documentation": "성명."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_address",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "address",
                  "visibility": "private",
                  "type": "String",
                  "multiplicity": "",
                  "documentation": "주소."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_contact",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "contact",
                  "visibility": "private",
                  "type": "String",
                  "multiplicity": "",
                  "documentation": "연락처."
                },
                {
                  "_type": "UMLAttribute",
                  "_id": "MWT_MM_CLASS_Member_ATTR_role",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "role",
                  "visibility": "private",
                  "type": "Role",
                  "multiplicity": "",
                  "documentation": "고객 또는 직원의 저장된 역할."
                }
              ],
              "operations": [
                {
                  "_type": "UMLOperation",
                  "_id": "MWT_MM_CLASS_Member_OP_Member",
                  "_parent": {
                    "$ref": "MWT_MM_CLASS_Member"
                  },
                  "name": "Member",
                  "visibility": "public",
                  "parameters": [
                    {
                      "_type": "UMLParameter",
                      "_id": "MWT_MM_CLASS_Member_OP_Member_PARAM_account",
                      "_parent": {
