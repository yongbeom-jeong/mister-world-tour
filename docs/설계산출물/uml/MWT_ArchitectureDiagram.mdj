						{
							"_type": "UMLClass",
							"_id": "MWT_TM_CLASS_TravelProduct",
							"_parent": {
								"$ref": "MWT_ARCH_TRAVEL"
							},
							"name": "TravelProduct",
							"documentation": "상품 정보·기본 구성·테마에 따른 정원·공동 모집 출발 상태를 보관한다. 허니문은 신청별 정확히2명으로 독립 출발하며 상품 공동 상태는 없다. 다른 테마는 상품전체 정원10·실제인원3이상 출발이다.",
							"attributes": [
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_productId",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "productId",
									"documentation": "저장 후 부여되는 상품 번호.",
									"visibility": "private",
									"type": "Integer",
									"multiplicity": "0..1"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_productName",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "productName",
									"documentation": "상품 이름.",
									"visibility": "private",
									"type": "String"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_theme",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "theme",
									"documentation": "허니문·효도·골프·트레킹.",
									"visibility": "private",
									"type": "Theme"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_tourLevel",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "tourLevel",
									"documentation": "초기 클래식·그랜드·프리미엄 등급.",
									"visibility": "private",
									"type": "TourLevel"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_basePrice",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "basePrice",
									"documentation": "1인 기본 가격.",
									"visibility": "private",
									"type": "Money"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_travelPeriod",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "travelPeriod",
									"documentation": "여행 기간.",
									"visibility": "private",
									"type": "TravelPeriod"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_departureDate",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "departureDate",
									"documentation": "직원이 상품별로 정한 하나의 출발일.",
									"visibility": "private",
									"type": "Date"
								},
								{
									"_type": "UMLAttribute",
									"_id": "MWT_TM_CLASS_TravelProduct_ATTR_defaultConfiguration",
									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "defaultConfiguration",
									"documentation": "자동 결정된 기본 구성.",
									"visibility": "private",
									"type": {
										"$ref": "MWT_TM_CLASS_TravelConfiguration"
									}
								},
								{
									"_type": "UMLAttribute",
