							"_type": "UMLInterfaceRealization",
							"_id": "MWT_SMS_REL_1",
							"_parent": {
								"$ref": "MWT_ARCH_SMS"
							},
							"documentation": "출발 확정 문자 제공 인터페이스 구현",
							"source": {
