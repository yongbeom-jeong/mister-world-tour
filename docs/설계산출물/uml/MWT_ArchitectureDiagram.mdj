									"_parent": {
										"$ref": "MWT_TM_CLASS_TravelProduct"
									},
									"name": "capacity",
									"documentation": "허니문은 신청단위2, 다른테마는 상품전체10. 교통 옵션으로 자동 변경하지 않는다.",
									"visibility": "private",
