# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git 에 올리지 않음, KEY=VALUE 형식)

# 직원 유형 가입 시 입력해야 하는 코드
STAFF_SIGNUP_CODE=MWT-STAFF-2026

# 배포 서버(--spring.profiles.active=prod)의 PostgreSQL. 개발 PC 는 H2 파일 DB(data/)라 비워 둔다.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 문자: Console(로그만, 기본) / FlakyDemo(재시도 시연: 번호마다 2번 실패 후 성공) / Solapi(솔라피로 실제 발송)
SMS_CLIENT=Console
# 솔라피 콘솔 > API Key 관리에서 발급. 발신번호는 솔라피에 등록·인증한 번호
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
# 실제로 문자를 받을 번호(쉼표 구분). 비우면 모든 번호로 발송되니 시연 중에는 팀원 번호만 넣어 둔다
SMS_ALLOWED_NUMBERS=
# 외부 호출 1회 대기(초), 신청 1건의 문자 묶음 전체 한도(초)
# SMS_TIMEOUT=10
# SMS_BATCH_TIME_LIMIT=40

# 음성 예약 대화: Scripted(규칙 대화, 기본) / OpenAI(LLM 대화. 실패한 턴은 규칙 대화로 답함)
VOICE_DIALOG_CLIENT=Scripted
# OpenAI 플랫폼 > API keys 에서 발급
OPENAI_API_KEY=
# 구조화 출력(JSON 스키마)을 지원하는 채팅 모델. 비우면 gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# LLM 1회 대기(초)
# VOICE_DIALOG_TIMEOUT=15
