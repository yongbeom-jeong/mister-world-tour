# 이 파일을 복사해 .env 로 만들고 값을 채운다. (.env 는 git 에 올리지 않음)
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 직원 유형 가입 시 입력해야 하는 코드
STAFF_SIGNUP_CODE=MWT-STAFF-2026

# 개발 PC: 비워 두면 SQLite(db.sqlite3) 사용. 배포 서버: 값을 넣으면 PostgreSQL 사용.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# 외부 서비스 (업체 미정: 클래스 경로로 교체)
# 문자: ConsoleSMSClient(로그만, 기본) / FlakyDemoSMSClient(재시도 시연: 번호마다 2번 실패 후 성공)
SMS_CLIENT=apps.sms.services.ConsoleSMSClient
# 음성: BrowserTranscriptClient(브라우저 Web Speech API 인식 결과 사용, 기본)
SPEECH_CLIENT=apps.speech.services.BrowserTranscriptClient
# 실제 업체 연동 시 사용할 키
# SMS_API_KEY=
# SPEECH_API_KEY=
